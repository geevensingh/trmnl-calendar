<div class="layout layout--col layout--top agenda" data-agenda-state="{{ state | escape }}">
  {% if state == "current" %}
    <div class="agenda-heading">
      <span class="title">{{ primary.label | escape }}</span>
      <span class="label">{{ primary.eligible_total }} eligible event{% unless primary.eligible_total == 1 %}s{% endunless %}</span>
    </div>
    <div class="agenda-primary">
      {% if primary.eligible_total == 0 %}
        <span class="description">No remaining events</span>
      {% else %}
        <table class="table table--large" data-table-limit="true">
          <tbody>
            {% for occurrence in primary.occurrences %}
              <tr>
                <td class="agenda-time">
                  {% if occurrence.time_kind == "all_day" %}
                    <span class="label label--large">All day</span>
                  {% else %}
                    <span class="label label--large"
                      data-agenda-start="{{ occurrence.start_at | escape }}"
                      data-agenda-end="{{ occurrence.end_at | escape }}"></span>
                  {% endif %}
                </td>
                <td><span class="title" data-clamp="1">{{ occurrence.title | escape }}</span></td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% endif %}
    </div>
    <div class="agenda-secondary">
      <span class="title title--small">{{ secondary.label | escape }}</span>
      <span class="label">{{ secondary.eligible_total }} eligible event{% unless secondary.eligible_total == 1 %}s{% endunless %}</span>
    </div>
  {% else %}
    <span class="title">Agenda unavailable</span>
    {% if error %}
      <span class="description">{{ error.message | escape }}</span>
      <span class="label">{{ error.code | escape }}</span>
    {% endif %}
  {% endif %}
</div>
<div class="title_bar">
  <span class="title">Agenda</span>
  <span class="instance agenda-source">Source checked:
    {% if source_succeeded_at %}
      <time data-agenda-source datetime="{{ source_succeeded_at | escape }}"></time>
    {% else %}
      <span>No successful source check</span>
    {% endif %}
  </span>
</div>
<script>
  (() => {
    const view = document.currentScript.closest(".view");
    const clock = new Intl.DateTimeFormat("en-US", {
      timeZone: "America/Los_Angeles", hour: "numeric", minute: "2-digit", hour12: true
    });
    for (const range of view.querySelectorAll("[data-agenda-start]")) {
      range.textContent = `${clock.format(new Date(range.dataset.agendaStart))} - ${clock.format(new Date(range.dataset.agendaEnd))}`;
    }
    const source = view.querySelector("[data-agenda-source]");
    if (source && source.dateTime) {
      source.textContent = new Intl.DateTimeFormat("en-US", {
        timeZone: "America/Los_Angeles", month: "short", day: "numeric", year: "numeric",
        hour: "numeric", minute: "2-digit", hour12: true, timeZoneName: "short"
      }).format(new Date(source.dateTime));
    }
  })();
</script>
