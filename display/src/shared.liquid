<style>
  .trmnl .agenda-view .layout.agenda {
    flex: 1; height: auto; min-height: 0; margin-bottom: 0;
    padding: var(--gap); gap: 4px; align-items: stretch;
  }
  .agenda .agenda-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; width: 100%; flex-shrink: 0; }
  .agenda .agenda-day-label { display: flex; align-items: baseline; gap: 8px; min-width: 0; max-width: 100%; white-space: nowrap; }
  .agenda .agenda-day-label > .title { flex-shrink: 0; }
  .agenda .agenda-count { white-space: normal; }
  .agenda .agenda-warning { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 8px; flex-shrink: 0; }
  .agenda .title { font-size: 21px; line-height: 1.4; }
  .agenda .label { line-height: 1.4; }
  .agenda .description { line-height: 1.4; overflow-wrap: anywhere; }
  .agenda > .title, .agenda > .label, .agenda > .description { flex-shrink: 0; }
  .agenda [hidden] { display: none !important; }
  .agenda .agenda-day { display: flex; flex-direction: column; gap: 4px; flex: 0 0 auto; width: 100%; }
  .agenda .agenda-day table { table-layout: fixed; width: 100%; }
  .agenda .table.table--large tbody tr { height: auto; }
  .agenda .table td { padding: 2px 0; vertical-align: top; }
  .agenda .agenda-day td .title {
    display: block; flex: 1 1 auto; min-width: 0; overflow: hidden;
    text-overflow: ellipsis; white-space: nowrap;
  }
  .agenda .agenda-event-heading {
    display: flex; align-items: baseline; gap: 8px; min-width: 0;
  }
  .agenda .agenda-participation { flex: 0 0 auto; white-space: nowrap; }
  .agenda .agenda-participation[data-expectation="definite"] { font-weight: bold; }
  .agenda .agenda-location {
    display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    font-size: 16px; line-height: 1.4;
  }
  .agenda .agenda-time { width: 230px; white-space: nowrap; }
  .agenda .agenda-day tr.agenda-emphasized td {
    padding: 4px 8px; background-color: #000; color: #fff;
  }
  .agenda .agenda-day tr.agenda-emphasized td .title {
    color: #fff; font-size: 24px; font-weight: 700; line-height: 1.25;
  }
  .agenda .agenda-emphasized .label { color: #fff; font-weight: 700; }
  .agenda .agenda-status { display: block; }
  .agenda .agenda-secondary { border-top: 2px solid; padding-top: 4px; }
  .agenda .agenda-source {
    display: flex; flex-wrap: wrap; justify-content: flex-end; column-gap: 4px;
    flex-shrink: 0; white-space: nowrap; font-size: 16px; line-height: 1.4;
  }
  .agenda-view[data-agenda-compact] .agenda-heading { flex-direction: column; gap: 0; }
  .agenda-view[data-agenda-compact] .agenda-source { align-self: flex-end; }
  .agenda-view[data-agenda-compact] .agenda-day tr { display: flex; flex-direction: column; }
  .agenda-view[data-agenda-compact] .agenda-day td { width: 100%; }
</style>
{% capture agenda_source %}
<span class="label agenda-source"><span>Source checked:</span>
  {% if source_succeeded_at %}
    <time data-agenda-source datetime="{{ source_succeeded_at | escape }}"></time>
  {% else %}
    <span>No successful source check</span>
  {% endif %}
</span>
{% endcapture %}
{% capture agenda_content %}
<div class="layout layout--col layout--top agenda" data-agenda-state="{{ state | escape }}">
  {% if state == "current" or state == "stale" %}
    {% if state == "stale" %}
      <div class="agenda-warning" role="status">
        <span class="title">Stale agenda</span>
        {% if error %}<span class="label">{{ error.message | escape }}</span>{% endif %}
      </div>
    {% endif %}
    {% assign day_names = "primary,secondary" | split: "," %}
    {% for day_name in day_names %}
      {% assign day = primary %}
      {% if day_name == "secondary" %}{% assign day = secondary %}{% endif %}
      <div class="agenda-{{ day_name }} agenda-day" data-agenda-total="{{ day.eligible_total }}">
        <div class="agenda-heading">
          <div class="agenda-day-label">
            <span class="title">{{ day.label | escape }}</span>
            {% if day.eligible_total == 0 %}
              <span class="label agenda-empty">No remaining events</span>
            {% else %}
              <span class="label agenda-count">0 of {{ day.eligible_total }} event{% unless day.eligible_total == 1 %}s{% endunless %} shown</span>
            {% endif %}
          </div>
          {% if day_name == "primary" %}{{ agenda_source }}{% endif %}
        </div>
        {% unless day.eligible_total == 0 %}
          <table class="table table--large">
            <tbody>
              {% for occurrence in day.occurrences %}
                {% assign occurrence_emphasis = nil %}
                {% if schema_version == 2 and occurrence contains "emphasis" %}{% assign occurrence_emphasis = occurrence.emphasis %}{% endif %}
                <tr hidden data-agenda-id="{{ occurrence.id | escape }}"{% if occurrence_emphasis %} class="agenda-emphasized" data-agenda-emphasis="{{ occurrence_emphasis | escape }}"{% endif %}>
                  <td class="agenda-time">
                    {% if occurrence.time_kind == "all_day" %}
                      <span class="label label--large">All day</span>
                    {% else %}
                      <span class="label label--large"
                        data-agenda-start="{{ occurrence.start_at | escape }}"
                        data-agenda-end="{{ occurrence.end_at | escape }}"></span>
                    {% endif %}
                  </td>
                  <td>
                    <div class="agenda-event-heading">
                      <span class="title">{{ occurrence.title | escape }}</span>
                      {% case occurrence.participation_expectation %}
                        {% when "definite" %}<span class="label agenda-participation" data-expectation="definite">Definite</span>
                        {% when "likely" %}<span class="label agenda-participation" data-expectation="likely">Likely</span>
                        {% when "maybe" %}<span class="label agenda-participation" data-expectation="maybe">Maybe</span>
                        {% when "unlikely" %}<span class="label agenda-participation" data-expectation="unlikely">Unlikely</span>
                        {% when "unknown" %}<span class="label agenda-participation" data-expectation="unknown">Unknown</span>
                      {% endcase %}
                    </div>
                    {% if occurrence_emphasis == "in_progress" %}
                      <span class="label agenda-status">IN PROGRESS</span>
                    {% elsif occurrence_emphasis == "upcoming" %}
                      <span class="label agenda-status">UPCOMING</span>
                    {% endif %}
                    {% if occurrence.location and occurrence.location != empty %}
                      <span class="label agenda-location" hidden>{{ occurrence.location | escape }}</span>
                    {% endif %}
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% endunless %}
      </div>
    {% endfor %}
  {% else %}
    <span class="title">Agenda unavailable</span>
    {% if error %}
      {% assign error_family = error.code | split: "_" | first %}
      <span class="label">{% case error_family %}{% when "configuration" %}Configuration error{% when "source" %}Source error{% when "refresh" %}Source refresh error{% when "compatibility" %}Compatibility error{% else %}Agenda error{% endcase %}</span>
      <span class="description">{{ error.message | escape }}</span>
      <span class="label">{{ error.code | escape }}</span>
    {% endif %}
    {{ agenda_source }}
  {% endif %}
</div>
<script>
  (() => {
    const view = document.currentScript.closest(".view");
    const agenda = view.querySelector(".agenda");
    view.classList.add("agenda-view");
    const clock = new Intl.DateTimeFormat("en-US", {
      timeZone: "America/Los_Angeles", hour: "numeric", minute: "2-digit", hour12: true
    });
    for (const range of view.querySelectorAll("[data-agenda-start]")) {
      range.textContent = `${clock.format(new Date(range.dataset.agendaStart))} - ${clock.format(new Date(range.dataset.agendaEnd))}`;
    }
    const source = view.querySelector("[data-agenda-source]");
    if (source && source.dateTime) {
      source.textContent = new Intl.DateTimeFormat("en-US", {
        timeZone: "America/Los_Angeles", month: "short", day: "numeric", year: "numeric",
        hour: "numeric", minute: "2-digit", hour12: true, timeZoneName: "short"
      }).format(new Date(source.dateTime));
    }
    const fit = () => {
      view.toggleAttribute("data-agenda-compact", view.clientWidth < 600);
      const days = [...agenda.querySelectorAll(".agenda-day")].map(element => ({
        rows: [...element.querySelectorAll("tbody tr")],
        count: element.querySelector(".agenda-count"),
        total: Number(element.dataset.agendaTotal),
        visible: 0
      }));
      const fits = () => agenda.scrollHeight <= agenda.clientHeight;
      const updateCount = day => {
        if (day.count) {
          const noun = day.total === 1 ? "event" : "events";
          day.count.textContent = day.visible === day.total
            ? `${day.total} ${noun}`
            : `${day.visible} of ${day.total} ${noun} shown`;
        }
      };
      const admitRow = (day, row) => {
        row.hidden = false;
        day.visible++;
        updateCount(day);
        if (!fits()) {
          row.hidden = true;
          day.visible--;
          updateCount(day);
          return false;
        }
        return true;
      };
      const admitRows = (day, rows) => {
        for (const row of rows) {
          if (!admitRow(day, row)) break;
        }
      };
      agenda.querySelectorAll(".agenda-location").forEach(location => { location.hidden = true; });
      for (const day of days) {
        day.rows.forEach(row => { row.hidden = true; });
        updateCount(day);
      }
      const [primary, secondary] = days;
      const emphasizedRows = days.flatMap(day => day.rows
        .filter(row => row.dataset.agendaEmphasis)
        .map(row => ({ day, row })));
      let allEmphasizedAdmitted = true;
      for (const { day, row } of emphasizedRows) {
        if (!admitRow(day, row)) {
          allEmphasizedAdmitted = false;
          break;
        }
      }
      if (allEmphasizedAdmitted && primary) {
        admitRows(primary, primary.rows.filter(row => !row.dataset.agendaEmphasis));
        if (primary.visible === primary.rows.length && secondary)
          admitRows(secondary, secondary.rows.filter(row => !row.dataset.agendaEmphasis));
      }
      for (const day of days) {
        for (const row of day.rows.filter(candidate => !candidate.hidden)) {
          const location = row.querySelector(".agenda-location");
          if (location) {
            location.hidden = false;
            if (!fits()) location.hidden = true;
          }
        }
      }
      agenda.dataset.agendaReady = "true";
    };
    let frame;
    const scheduleFit = () => {
      agenda.dataset.agendaReady = "false";
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(fit);
    };
    document.fonts.ready.then(scheduleFit);
    document.fonts.addEventListener("loadingdone", scheduleFit);
    // Finish fitting before the framework publishes capture readiness.
    window.addEventListener("trmnl:terminalize:stats", fit);
    new ResizeObserver(scheduleFit).observe(view);
  })();
</script>
{% endcapture %}
